# 保护所有 .json 文件（修复原 ^\.(json)$ 正则 bug）
<FilesMatch "\.json$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 保护 data 目录中的非 PHP 文件（.htaccess 中无法使用 <Directory>，改用 FilesMatch）
# data/ 目录通过 .json 规则保护 JSON；其余敏感文件通过下方规则单独保护

# 保护密码哈希文件（后台 + 文案库访问）
<FilesMatch "^\.(lib_pwd_hash|pwd_hash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 保护原子写入临时文件与锁文件
<FilesMatch "\.(tmp|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 安全头
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
    # HSTS：仅在 HTTPS 下生效，强制浏览器后续使用 HTTPS
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# HTTPS 强制跳转（排除 localhost 本地开发环境）
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 启用 PHP
AddHandler application/x-httpd-php .php

# 防止目录列表
Options -Indexes

# 启用 GZIP 压缩
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript
    # 异步任务创建接口设置了 Content-Length 用于提前关闭连接，
    # GZIP 压缩会改变响应体长度但不更新 Content-Length 头部，
    # 导致浏览器报 ERR_CONTENT_LENGTH_MISMATCH 错误，需禁用这些 URL 的压缩
    SetEnvIf Request_URI "action=aiVideoCreate" no-gzip=1
    SetEnvIf Request_URI "action=aiGenerateImage" no-gzip=1
</IfModule>
